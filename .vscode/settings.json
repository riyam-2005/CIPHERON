{
    "cmake.sourceDirectory": "${workspaceFolder}/firmware",
    "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
    "python.venvPath": "${workspaceFolder}/backend",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/backend",
        "${workspaceFolder}/backend/.venv/Lib/site-packages"
    ],
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/backend",
        "${workspaceFolder}/backend/.venv/Lib/site-packages"
    ],
    "python.testing.pytestArgs": [
        "backend/tests"
    ],
    "python.testing.pytestEnabled": true,
    "C_Cpp.default.compilerPath": "C:/MinGW/bin/g++.exe",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x86",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/firmware/main",
        "${workspaceFolder}/firmware/main/config",
        "${workspaceFolder}/firmware/main/tasks",
        "C:/MinGW/include",
        "C:/MinGW/lib/gcc/mingw32/6.3.0/include",
        "C:/MinGW/lib/gcc/mingw32/6.3.0/include/c++",
        "C:/MinGW/lib/gcc/mingw32/6.3.0/include/c++/mingw32"
    ]
}
